---
interface Props {
  variant: "toc" | "main";
}

const { variant } = Astro.props;
---

<a href="/" class:list={["back-link", `back-link--${variant}`]}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="14"
    height="14"
    aria-hidden="true"
    class="back-icon"
  >
    <path
      d="M10 15 L4 9 L10 3"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    />
    <path
      d="M4 9 H13 Q23 9 20 22"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    />
  </svg>
  Index
</a>

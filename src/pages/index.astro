---
import PageLayout from "../layouts/PageLayout.astro";
import { formatDayMonth, formatYear, resolveDate, resolveSlug } from "../utils/dates";
import { getSortedPublishedWriting } from "../utils/writing";

const entries = await getSortedPublishedWriting();
const sorted = entries.map((entry) => {
  const date = resolveDate(entry);
  return {
    title: entry.data.title,
    shortTitle: entry.data.shortTitle ?? entry.data.title,
    date,
    year: formatYear(date),
    dayMonth: formatDayMonth(date),
    route: `/writing/${resolveSlug(entry.id, entry.data.routeOverride)}`,
  };
});

let seenYear = "";
const posts = sorted.map((post) => {
  const showYear = post.year !== seenYear;
  seenYear = post.year;
  return { ...post, showYear };
});
---

<PageLayout isHome={true}>
  <article class="article homepage">
    <header>
      <div class="home-name">
        <h1>Jan Celada</h1>
        <img
          src="/cat-lounging.svg"
          width="22"
          height="14"
          alt=""
          aria-hidden="true"
          class="home-cat"
        />
      </div>
      <span class="article-date">raquezha · Senior Android Developer</span>
    </header>
    <p>I build Android applications and developer tools with Kotlin.</p>
    <p>
      At Nueca, I focus on mobile architecture, Jetpack Compose, Kotlin
      Multiplatform, CI/CD release automation, and practical AI agent workflows.
    </p>
    <p>
      Outside client apps, I maintain open-source tools like{" "}
      <a href="https://github.com/raquezha/nothing" target="_blank" rel="noopener noreferrer">nothing</a>,{" "}
      <a href="https://github.com/raquezha/spaces" target="_blank" rel="noopener noreferrer">Spaces</a>,
      and{" "}
      <a href="https://github.com/raquezha/kinsena" target="_blank" rel="noopener noreferrer">kinsena</a>.
    </p>
    <p>
      You can explore my code on{" "}
      <a href="https://github.com/raquezha" target="_blank" rel="noopener noreferrer">GitHub</a>{" "}
      or reach out for engineering roles on{" "}
      <a href="https://www.linkedin.com/in/jancelada/" target="_blank" rel="noopener noreferrer">LinkedIn</a>{posts.length > 0 ? ", or read longer notes below." : "."}
    </p>
  </article>

  {posts.length > 0 && (
    <section class="writing">
      <h2>Writing</h2>
      <ul>
        {posts.map((post, idx) => (
          <li style={`--stagger: ${idx}`}>
            <a href={post.route} title={post.title}>
              <span class="post-year" aria-hidden={!post.showYear}>
                {post.showYear ? post.year : ""}
              </span>
              <span class="title">{post.shortTitle}</span>
              <time class="post-date" datetime={post.date} data-date={post.date}>
                {post.dayMonth}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</PageLayout>

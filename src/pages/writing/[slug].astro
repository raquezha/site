---
import { getCollection, render } from "astro:content";
import BackLink from "../../components/BackLink.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { formatLongDate, isPublished, resolveDate, resolveSlug } from "../../utils/dates";

export async function getStaticPaths() {
  const entries = await getCollection("writing", isPublished);
  return entries.map((entry) => ({
    params: { slug: resolveSlug(entry.id, entry.data.routeOverride) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, format = "prose", acknowledgements = [] } = entry.data;
const date = resolveDate(entry);
const h2Headings = headings.filter((h) => h.depth === 2);
const showToc = h2Headings.length >= 3;
---

<PageLayout title={title} description={description}>
  <div class:list={["post-layout", { "post-layout--with-toc": showToc }]}>
    {showToc && (
      <aside class="post-toc" aria-label="On this page">
        <BackLink variant="toc" />
        <a href="#" class="post-toc-post-title" aria-hidden="true" tabindex="-1">
          {entry.data.shortTitle ?? title}
        </a>
        <nav aria-label="Table of contents">
          <ul>
            {h2Headings.map((heading, idx) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class:list={["post-toc-link", { "is-active": idx === 0 }]}
                  data-toc-slug={heading.slug}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
    <div class="post-main">
      <BackLink variant="main" />
      <article class:list={["article post", { "post--poetry": format === "poetry" }]}>
        <header>
          <h1>{title}</h1>
          <time class="article-date" datetime={date} data-date={date}>
            {formatLongDate(date)}
          </time>
        </header>
        <Content />
        {acknowledgements.length > 0 && (
          <section class="acknowledgements" aria-labelledby="ack-heading">
            <h3 id="ack-heading">Acknowledgements</h3>
            {acknowledgements.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        )}
      </article>
    </div>
  </div>
  <template id="code-copy-tpl">
    <svg class="icon-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </template>
  <script is:inline>
    (() => {
      function initTocScrollSpy() {
        const links = Array.from(document.querySelectorAll(".post-toc-link"));
        if (!links.length) return;
        const targets = links
          .map((link) => document.getElementById(link.getAttribute("data-toc-slug") || ""))
          .filter(Boolean);
        if (!targets.length) return;

        const setActive = (id) => {
          for (const link of links) {
            link.classList.toggle("is-active", link.getAttribute("data-toc-slug") === id);
          }
        };

        const syncScrollActive = () => {
          if (window.scrollY < 40) {
            setActive(targets[0].id);
            return;
          }
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8) {
            setActive(targets[targets.length - 1].id);
            return;
          }
          let current = targets[0].id;
          for (const target of targets) {
            if (target.getBoundingClientRect().top <= 140) current = target.id;
          }
          setActive(current);
        };

        window.addEventListener("scroll", syncScrollActive, { passive: true });
        window.addEventListener("resize", syncScrollActive, { passive: true });
        syncScrollActive();

        const tocTitle = document.querySelector(".post-toc-post-title");
        const postH1 = document.querySelector(".post > header h1");
        if (!tocTitle || !postH1) return;

        tocTitle.addEventListener("click", (e) => {
          e.preventDefault();
          const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: 0, behavior: reduced ? "instant" : "smooth" });
        });
        const titleObserver = new IntersectionObserver(
          ([entry]) => {
            const scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
            if (!scrolledPast && document.activeElement === tocTitle) {
              const backLink = document.querySelector(".post-toc .back-link");
              if (backLink instanceof HTMLElement) {
                backLink.focus({ preventScroll: true });
              } else {
                tocTitle.blur();
              }
            }
            tocTitle.classList.toggle("is-visible", scrolledPast);
            tocTitle.setAttribute("aria-hidden", String(!scrolledPast));
            tocTitle.setAttribute("tabindex", scrolledPast ? "0" : "-1");
          },
          { threshold: 0 }
        );
        titleObserver.observe(postH1);
      }

      function enableTaskCheckboxes() {
        for (const cb of document.querySelectorAll('.post .task-list-item input[type="checkbox"]')) {
          cb.removeAttribute("disabled");
        }
      }

      function initCodeCopyButtons() {
        const tpl = document.getElementById("code-copy-tpl");
        if (!(tpl instanceof HTMLTemplateElement)) return;
        for (const pre of document.querySelectorAll(".article pre")) {
          const code = pre.querySelector("code");
          if (!code || pre.querySelector(".code-copy-btn")) continue;
          if (!code.hasAttribute("tabindex")) {
            code.setAttribute("tabindex", "0");
            code.setAttribute("role", "region");
            code.setAttribute("aria-label", "Code snippet");
          }
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "code-copy-btn";
          btn.setAttribute("aria-label", "Copy code");
          btn.appendChild(tpl.content.cloneNode(true));
          let timer;
          btn.addEventListener("click", async () => {
            try {
              await navigator.clipboard?.writeText(code.innerText);
            } catch {}
            btn.classList.add("is-copied");
            btn.setAttribute("aria-label", "Copied");
            clearTimeout(timer);
            timer = setTimeout(() => {
              btn.classList.remove("is-copied");
              btn.setAttribute("aria-label", "Copy code");
            }, 1500);
          });
          pre.appendChild(btn);
        }
      }

      initTocScrollSpy();
      enableTaskCheckboxes();
      initCodeCopyButtons();
    })();
  </script>
</PageLayout>

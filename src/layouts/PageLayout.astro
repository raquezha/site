---
import { SITE_DESCRIPTION, SITE_TITLE } from "../utils/writing";

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  isHome = false,
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isHome ? "website" : "article"} />
    <meta property="og:url" content={canonicalUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&display=swap"
    />
    <link rel="stylesheet" href="/site.css" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <script is:inline>
      // Prevent entrance blur-cascade from doubling on MPA view-transitions or back/forward history
      const navType = performance.getEntriesByType?.("navigation")?.[0]?.type;
      if (navType === "back_forward") {
        document.documentElement.classList.add("home-visited", "is-view-transition");
      }
      window.addEventListener("pagereveal", (e) => {
        if (!e.viewTransition) return;
        document.documentElement.classList.add("is-view-transition");
        if (!window.navigation?.activation) return;
        const fromUrl = window.navigation.activation.from?.url;
        if (!fromUrl) return;
        const fromPath = new URL(fromUrl).pathname;
        const toPath = location.pathname;
        if (fromPath.startsWith("/writing/") && toPath === "/") {
          document.documentElement.classList.add("home-visited");
          e.viewTransition.types.add("backward");
        } else if (toPath.startsWith("/writing/")) {
          e.viewTransition.types.add("forward");
        }
      });
    </script>
  </head>
  <body class:list={[{ "is-home": isHome, "is-post": !isHome }]}>
    <main class:list={["container", { "container--home": isHome, "container--post": !isHome }]}>
      <slot />
      {isHome && (
        <footer class="footer">
          <span>Based in the Philippines with eight cats.</span>
          <span class="footer-cat-slot" aria-hidden="true">

  "surface": {
    "background": {
      "$type": "color",
      "$value": "{colors.solid.paper.100}",
      "$description": "Primary page canvas background",
      "$extensions": {
        "com.nodesign": {
          "collection": "Color: Semantic",
          "mode": "Light",
          "scopes": ["FRAME_FILL", "SHAPE_FILL"],
          "codeSyntax": {
            "WEB": "--surface-background",
            "ANDROID": "AppColors.surfaceBackground",
            "iOS": "AppColors.surfaceBackground"
          }
